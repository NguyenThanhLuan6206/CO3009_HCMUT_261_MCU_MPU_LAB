void setTrafficLightPins(GPIO_PinState r1, GPIO_PinState a1, GPIO_PinState g1,
                         GPIO_PinState r2, GPIO_PinState a2, GPIO_PinState g2) {
    // �?ư�?ng 1: PA1 (�?�?), PA2 (Vàng), PA3 (Xanh)
    HAL_GPIO_WritePin(GPIOA, PA1_Pin, r1);
    HAL_GPIO_WritePin(GPIOA, PA2_Pin, a1);
    HAL_GPIO_WritePin(GPIOA, PA3_Pin, g1);
    // �?ư�?ng 2: PA4 (�?�?), PA5 (Vàng), PA6 (Xanh)
    HAL_GPIO_WritePin(GPIOA, PA4_Pin, r2);
    HAL_GPIO_WritePin(GPIOA, PA5_Pin, a2);
    HAL_GPIO_WritePin(GPIOA, PA6_Pin, g2);
}

void resetNormalMode(void) {
    traffic_state = STATE_RED1_GREEN2;
    road1_counter = red_time;
    road2_counter = green_time;
    setTimer1(1000);
}

void display7SEG(int num) {
    if (num < 0 || num > 9) num = 0;
    uint8_t code = segmentNumber[num];
    // 7SEG-COM-ANODE: bit 0 (RESET) là sáng đoạn, bit 1 (SET) là tắt đoạn
    HAL_GPIO_WritePin(PB9_GPIO_Port, PB9_Pin, (code >> 0) & 0x01); // đoạn a
    HAL_GPIO_WritePin(PB8_GPIO_Port, PB8_Pin, (code >> 1) & 0x01); // đoạn b
    HAL_GPIO_WritePin(PB7_GPIO_Port, PB7_Pin, (code >> 2) & 0x01); // đoạn c
    HAL_GPIO_WritePin(PB6_GPIO_Port, PB6_Pin, (code >> 3) & 0x01); // đoạn d
    HAL_GPIO_WritePin(PB5_GPIO_Port, PB5_Pin, (code >> 4) & 0x01); // đoạn e
    HAL_GPIO_WritePin(PB4_GPIO_Port, PB4_Pin, (code >> 5) & 0x01); // đoạn f
    HAL_GPIO_WritePin(PB3_GPIO_Port, PB3_Pin, (code >> 6) & 0x01); // đoạn g
}

void update7SEG(int val1, int val2) {
    led_buffer[0] = val1 / 10;
    led_buffer[1] = val1 % 10;
    led_buffer[2] = val2 / 10;
    led_buffer[3] = val2 % 10;

    // 1. TẮT tất cả 4 LED trước khi xuất dữ liệu mới
    // (Dùng Transistor PNP: Kéo PA7..PA10 lên mức SET/3.3V để ngắt dòng)
    HAL_GPIO_WritePin(PA7_GPIO_Port, PA7_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(PA8_GPIO_Port, PA8_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(PA9_GPIO_Port, PA9_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(PA10_GPIO_Port, PA10_Pin, GPIO_PIN_SET);

    // Xuất mã 7 đoạn ra Port B
    display7SEG(led_buffer[index_led]);

    // 2. BẬT duy nhất 1 LED đến lượt quét
    // (Dùng Transistor PNP: Kéo chân tương ứng xuống mức RESET/0V để kích dẫn)
    switch (index_led) {
        case 0:
            HAL_GPIO_WritePin(PA7_GPIO_Port, PA7_Pin, GPIO_PIN_RESET);
            break;
        case 1:
            HAL_GPIO_WritePin(PA8_GPIO_Port, PA8_Pin, GPIO_PIN_RESET);
            break;
        case 2:
            HAL_GPIO_WritePin(PA9_GPIO_Port, PA9_Pin, GPIO_PIN_RESET);
            break;
        case 3:
            HAL_GPIO_WritePin(PA10_GPIO_Port, PA10_Pin, GPIO_PIN_RESET);
            break;
    }

    index_led++;
    if (index_led >= MAX_LED) {
        index_led = 0;
    }
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM2) {
        timerRun();
        getKeyInput();
    }
}

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  __HAL_RCC_AFIO_CLK_ENABLE();
  __HAL_AFIO_REMAP_SWJ_NOJTAG();

  HAL_TIM_Base_Start_IT(&htim2);

  resetNormalMode();
  setTimer2(250);
  setTimer3(100);
  update7SEG(road1_counter, road2_counter);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      // 1. Nút nhấn 1 (PB0 - Index 0): Chuyển đổi chế độ Mode 1 -> 2 -> 3 -> 4 -> 1
      if (isButtonPressed(0) == 1) {
          current_mode++;
          if (current_mode > 4) {
              current_mode = 1;
              resetNormalMode();
          } else {
              // Tắt toàn bộ 12 LED đơn trước khi vào Mode chỉnh sửa
              setTrafficLightPins(LED_OFF, LED_OFF, LED_OFF, LED_OFF, LED_OFF, LED_OFF);
              temp_red_time = red_time;
              temp_amber_time = amber_time;
              temp_green_time = green_time;
              setTimer2(250);
          }
      }

      // 2. Xử lý máy trạng thái theo từng Mode
      if (current_mode == 1) {
          // MODE 1: Hệ thống đèn giao thông hoạt động bình thư�?ng
          switch (traffic_state) {
              case STATE_RED1_GREEN2:
                  setTrafficLightPins(LED_ON, LED_OFF, LED_OFF, LED_OFF, LED_OFF, LED_ON);
                  if (timer1_flag == 1) {
                      setTimer1(1000);
                      road1_counter--;
                      road2_counter--;
                      if (road2_counter <= 0) {
                          traffic_state = STATE_RED1_AMBER2;
                          road2_counter = amber_time;
                      }
                  }
                  break;

              case STATE_RED1_AMBER2:
                  setTrafficLightPins(LED_ON, LED_OFF, LED_OFF, LED_OFF, LED_ON, LED_OFF);
                  if (timer1_flag == 1) {
                      setTimer1(1000);
                      road1_counter--;
                      road2_counter--;
                      if (road2_counter <= 0) {
                          traffic_state = STATE_GREEN1_RED2;
                          road1_counter = green_time;
                          road2_counter = red_time;
                      }
                  }
                  break;

              case STATE_GREEN1_RED2:
                  setTrafficLightPins(LED_OFF, LED_OFF, LED_ON, LED_ON, LED_OFF, LED_OFF);
                  if (timer1_flag == 1) {
                      setTimer1(1000);
                      road1_counter--;
                      road2_counter--;
                      if (road1_counter <= 0) {
                          traffic_state = STATE_AMBER1_RED2;
                          road1_counter = amber_time;
                      }
                  }
                  break;

              case STATE_AMBER1_RED2:
                  setTrafficLightPins(LED_OFF, LED_ON, LED_OFF, LED_ON, LED_OFF, LED_OFF);
                  if (timer1_flag == 1) {
                      setTimer1(1000);
                      road1_counter--;
                      road2_counter--;
                      if (road1_counter <= 0) {
                          traffic_state = STATE_RED1_GREEN2;
                          road1_counter = red_time;
                          road2_counter = green_time;
                      }
                  }
                  break;
          }
      }
      else if (current_mode == 2) {
          // MODE 2: Tinh chỉnh th�?i gian LED �?�? (PA1, PA4)
          time_value = temp_red_time;
          if (isButtonPressed(1) == 1) {
              temp_red_time++;
              if (temp_red_time > 99) temp_red_time = 1;
          }
          if (isButtonPressed(2) == 1) {
              red_time = temp_red_time;
          }
      }
      else if (current_mode == 3) {
          // MODE 3: Tinh chỉnh th�?i gian LED Vàng (PA2, PA5)
          time_value = temp_amber_time;
          if (isButtonPressed(1) == 1) {
              temp_amber_time++;
              if (temp_amber_time > 99) temp_amber_time = 1;
          }
          if (isButtonPressed(2) == 1) {
              amber_time = temp_amber_time;
          }
      }
      else if (current_mode == 4) {
          // MODE 4: Tinh chỉnh th�?i gian LED Xanh (PA3, PA6)
          time_value = temp_green_time;
          if (isButtonPressed(1) == 1) {
              temp_green_time++;
              if (temp_green_time > 99) temp_green_time = 1;
          }
          if (isButtonPressed(2) == 1) {
              green_time = temp_green_time;
          }
      }

      // 3. Chớp tắt LED 2Hz khi ở trong các Mode 2, 3, 4
      if (timer2_flag == 1) {
          setTimer2(250);
          if (current_mode == 2) {
              HAL_GPIO_TogglePin(GPIOA, PA1_Pin | PA4_Pin);
          } else if (current_mode == 3) {
              HAL_GPIO_TogglePin(GPIOA, PA2_Pin | PA5_Pin);
          } else if (current_mode == 4) {
              HAL_GPIO_TogglePin(GPIOA, PA3_Pin | PA6_Pin);
          }
      }

      // 4. Quét hiển thị 4 LED 7 đoạn
        if (timer3_flag == 1) {
            setTimer3(100); // Tăng giá trị từ 20 lên 100 hoặc lớn hơn
            if (current_mode == 1) {
                update7SEG(road1_counter, road2_counter);
            } else {
                update7SEG(current_mode, time_value);
            }
        }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}


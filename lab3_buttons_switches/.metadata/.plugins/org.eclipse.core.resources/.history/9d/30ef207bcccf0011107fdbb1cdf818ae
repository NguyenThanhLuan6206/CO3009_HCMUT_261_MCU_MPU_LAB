/* USER CODE BEGIN 4 */
void display7SEG(int num) {
    uint8_t code = segmentNumber[num];
    HAL_GPIO_WritePin(PB3_GPIO_Port, PB3_Pin, (code >> 0) & 0x01);
    HAL_GPIO_WritePin(PB4_GPIO_Port, PB4_Pin, (code >> 1) & 0x01);
    HAL_GPIO_WritePin(PB5_GPIO_Port, PB5_Pin, (code >> 2) & 0x01);
    HAL_GPIO_WritePin(PB6_GPIO_Port, PB6_Pin, (code >> 3) & 0x01);
    HAL_GPIO_WritePin(PB7_GPIO_Port, PB7_Pin, (code >> 4) & 0x01);
    HAL_GPIO_WritePin(PB8_GPIO_Port, PB8_Pin, (code >> 5) & 0x01);
    HAL_GPIO_WritePin(PB9_GPIO_Port, PB9_Pin, (code >> 6) & 0x01);
}

void update7SEG(int mode, int time_value) {
    led_buffer[0] = mode / 10;
    led_buffer[1] = mode % 10;
    led_buffer[2] = time_value / 10;
    led_buffer[3] = time_value % 10;

    HAL_GPIO_WritePin(PA7_GPIO_Port, PA7_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(PA8_GPIO_Port, PA8_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(PA9_GPIO_Port, PA9_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(PA10_GPIO_Port, PA10_Pin, GPIO_PIN_SET);

    display7SEG(led_buffer[index_led]);

    switch (index_led) {
        case 0:
            HAL_GPIO_WritePin(PA7_GPIO_Port, PA7_Pin, GPIO_PIN_RESET);
            break;
        case 1:
            HAL_GPIO_WritePin(PA8_GPIO_Port, PA8_Pin, GPIO_PIN_RESET);
            break;
        case 2:
            HAL_GPIO_WritePin(PA9_GPIO_Port, PA9_Pin, GPIO_PIN_RESET);
            break;
        case 3:
            HAL_GPIO_WritePin(PA10_GPIO_Port, PA10_Pin, GPIO_PIN_RESET);
            break;
    }

    index_led++;
    if (index_led >= MAX_LED) {
        index_led = 0;
    }
}


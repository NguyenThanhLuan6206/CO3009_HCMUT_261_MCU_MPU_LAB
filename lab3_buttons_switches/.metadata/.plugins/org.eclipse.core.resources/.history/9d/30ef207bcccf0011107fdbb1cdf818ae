/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_Base_Start_IT(&htim2);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  setTimer2(250);
  setTimer3(10);
  while (1)
  {
    /* USER CODE END WHILE */
    if (isButtonPressed(0) == 1) {
	    current_mode++;
	    if (current_mode > 4) {
		    current_mode = 1;
	    }
	    HAL_GPIO_WritePin(GPIOA, PA1_Pin | PA2_Pin | PA3_Pin | PA4_Pin | PA5_Pin | PA6_Pin, GPIO_PIN_RESET);
	    temp_red_time = red_time;
	    temp_amber_time = amber_time;
	    temp_green_time = green_time;
    }

	if (current_mode == 2) {
		time_value = temp_red_time;

		if (isButtonPressed(1) == 1) {
			temp_red_time++;
			if (temp_red_time > 99) {
				temp_red_time = 1;
			}
		}

		if (isButtonPressed(2) == 1) {
			red_time = temp_red_time;
		}
  	}
	if (current_mode == 3) {
		time_value = temp_amber_time;
		if (isButtonPressed(1) == 1) {
			temp_amber_time++;
			if (temp_amber_time > 99) {
				temp_amber_time = 1;
			}
		}
		if (isButtonPressed(2) == 1) {
			amber_time = temp_amber_time;
		}
	}
	if (current_mode == 4) {
	    time_value = temp_green_time;
	    if (isButtonPressed(1) == 1) {
	        temp_green_time++;
	        if (temp_green_time > 99) {
	            temp_green_time = 1;
	        }
	    }
	    if (isButtonPressed(2) == 1) {
	        green_time = temp_green_time;
	    }
	}
	if (timer2_flag == 1) {
	    setTimer2(250);
	    if (current_mode == 2) {
	        HAL_GPIO_TogglePin(GPIOA, PA1_Pin | PA4_Pin);
	    } else if (current_mode == 3) {
	        HAL_GPIO_TogglePin(GPIOA, PA2_Pin | PA5_Pin);
	    } else if (current_mode == 4) {
	        HAL_GPIO_TogglePin(GPIOA, PA3_Pin | PA6_Pin);
	    }
	}
	if (timer3_flag == 1) {
	    setTimer3(5);
	    update7SEG(current_mode, time_value);
	}
    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}


#ifndef INC_SCHEDULER_H_
#define INC_SCHEDULER_H_

#include <stdint.h>

// Định nghĩa số lượng task tối đa và ID mặc định theo tài liệu[cite: 14]
#define SCH_MAX_TASKS 40
#define NO_TASK_ID 0

// Cấu trúc một Node trong Delta-list
typedef struct sTask {
    void (*pTask)(void);      // Con trỏ trỏ đến hàm task[cite: 14]
    uint32_t Delay;           // Khoảng thời gian chờ tương đối (delta time) tính bằng ticks[cite: 14]
    uint32_t Period;          // Chu kỳ thực thi của task (ticks)[cite: 14]
    uint8_t RunMe;            // Cờ báo hiệu task đã đến lúc chạy[cite: 14]
    uint32_t TaskID;          // ID quản lý task[cite: 14]
    struct sTask* pNext;      // Con trỏ liên kết đến task tiếp theo trong hàng đợi
} sTask;

// Khai báo các hàm cốt lõi theo yêu cầu của mục Problem[cite: 22]
void SCH_Init(void);
void SCH_Update(void);
void SCH_Dispatch_Tasks(void);
uint32_t SCH_Add_Task(void (*pFunction)(), uint32_t DELAY, uint32_t PERIOD);
uint8_t SCH_Delete_Task(uint32_t taskID);

#endif /* INC_SCHEDULER_H_ */

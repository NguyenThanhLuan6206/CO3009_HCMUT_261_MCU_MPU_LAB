// Hàm nội bộ: Chèn task vào danh sách theo nguyên lý độ trễ tương đối (Delta time)
static void SCH_Insert_Task_To_List(sTask* newNode) {
    if (head == NULL) {
        head = newNode;
        newNode->pNext = NULL;
        return;
    }

    sTask* current = head;
    sTask* previous = NULL;

    while (current != NULL && newNode->Delay >= current->Delay) {
        newNode->Delay -= current->Delay;
        previous = current;
        current = current->pNext;
    }

    if (previous == NULL) {
        newNode->pNext = head;
        head->Delay -= newNode->Delay;
        head = newNode;
    } else {
        previous->pNext = newNode;
        newNode->pNext = current;
        if (current != NULL) {
            current->Delay -= newNode->Delay;
        }
    }
}


#ifndef SCHEDULER_H_
#define SCHEDULER_H_

#include <stdint.h>


#define SCH_MAX_TASKS 40
#define NO_TASK_ID 0

typedef struct sTask {
    void (*pTask)(void);
    uint32_t Delay;
    uint32_t Period;
    uint8_t RunMe;
    uint32_t TaskID;
    struct sTask* pNext;
} sTask;

void SCH_Init(void);
uint32_t SCH_Add_Task(void (*pFunction)(), uint32_t DELAY, uint32_t PERIOD);
void SCH_Update(void);
void SCH_Dispatch_Tasks(void);
uint8_t SCH_Delete_Task(uint32_t taskID);

#endif /* SCHEDULER_H_ */

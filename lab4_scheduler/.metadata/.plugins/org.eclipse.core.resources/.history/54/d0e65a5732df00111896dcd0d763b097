#ifndef INC_SCHEDULER_H_
#define INC_SCHEDULER_H_

#include <stdint.h>

// Định nghĩa số lượng task tối đa và ID mặc định
#define SCH_MAX_TASKS 40
#define NO_TASK_ID 0

// Cấu trúc Task tiêu chuẩn (Không dùng Linked List)
typedef struct {
    void (*pTask)(void);      // Con trỏ trỏ đến hàm task
    uint32_t Delay;           // Khoảng thời gian chờ đếm ngược (ticks)
    uint32_t Period;          // Chu kỳ thực thi của task (ticks)
    uint8_t RunMe;            // Cờ báo hiệu task đã đến lúc chạy
    uint32_t TaskID;          // ID quản lý task
} sTask;

// Khai báo các hàm cốt lõi của bộ điều phối
void SCH_Init(void);
void SCH_Update(void);
void SCH_Dispatch_Tasks(void);
uint32_t SCH_Add_Task(void (*pFunction)(void), uint32_t DELAY, uint32_t PERIOD);
uint8_t SCH_Delete_Task(uint32_t taskID);

#endif /* INC_SCHEDULER_H_ */

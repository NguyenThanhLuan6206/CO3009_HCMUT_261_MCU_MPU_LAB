// Định tuyến hàm printf qua UART1 để in timestamp ra Terminal[cite: 23]
#ifdef __GNUC__
#define PUTCHAR_PROTOTYPE int __io_putchar(int ch)
#else
#define PUTCHAR_PROTOTYPE int fputc(int ch, FILE *f)
#endif

PUTCHAR_PROTOTYPE
{
  HAL_UART_Transmit(&huart1, (uint8_t *)&ch, 1, HAL_MAX_DELAY);
  return ch;
}

// Định nghĩa 5 Task định kỳ in ra thời gian hệ thống (timestamp)[cite: 22, 23]
void Task1_0_5s(void) {
    printf("Task 1 (0.5s) - Timestamp: %lu ms\r\n", HAL_GetTick());
}

void Task2_1_0s(void) {
    printf("Task 2 (1.0s) - Timestamp: %lu ms\r\n", HAL_GetTick());
    // Ví dụ chớp tắt LED_TEST mỗi 1s[cite: 12]
    HAL_GPIO_TogglePin(LED_TEST_GPIO_Port, LED_TEST_Pin);
}

void Task3_1_5s(void) {
    printf("Task 3 (1.5s) - Timestamp: %lu ms\r\n", HAL_GetTick());
}

void Task4_2_0s(void) {
    printf("Task 4 (2.0s) - Timestamp: %lu ms\r\n", HAL_GetTick());
}

void Task5_2_5s(void) {
    printf("Task 5 (2.5s) - Timestamp: %lu ms\r\n", HAL_GetTick());
}
